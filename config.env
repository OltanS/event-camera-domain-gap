# --- Data Options ---
# The model pulls its parameters from here and adjusts to the input data
EXPORT_DVS=1
EXPORT_APS=1
BINSIZE_MS=50
HEIGHT=224
WIDTH=224
# 16 for np.float16 or 32 for np.float32 respectively
PRECISION=16

# --- Location Options ---
DDD20_UTILS_DIR=/home/oltans/snn_development/ddd20-utils
DDD20_UTILS_VENV_DIR=/home/oltans/virtual_environments/DDD20-utils
VENV_DIR=/home/oltans/virtual_environments/DDD20-utils
IN_DIR=/home/oltans/snn_development/datasets/DDD17
OUT_DIR=/home/oltans/snn_development/datasets/Processed-Recordings
CSV_FILE=/home/oltans/snn_development/recording-start-stop.csv
MODEL_SAVE_DIR=/home/oltans/snn_development/models


# --- Preprocessing Options ---
# if true, the pruned data will be saved in OUT_DIR/Training/Pruned-Recordings
PERFORM_PRUNING=1
# the below don't matter if PERFORM_PRUNING is 0
SPEED_PRUNING=1
STEERING_PRUNING=1
# km/h for speed to be considered high enough
SPEED_THRESHOLD=15
# absolute value for degree of steering to be considered high enough
STEERING_THRESHOLD=3
STEERING_DISCARD_CHANCE=0.7

# --- Training Options ---
TRAINING_SPLIT=0.8
EPOCHS=50
BATCH_SIZE=64
LEARNING_RATE=0.001
WEIGHT_DECAY=0.0001
