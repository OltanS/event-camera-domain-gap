PACKAGE_NAME=ddd-rnn

# --- Training Options ---
# Options are "Resnet", "ResnetRNN" and "ResnetRNNStated"
MODEL_TYPE="ResnetRNN"
PRETRAINED=1
USE_DVS=1
USE_APS=1
WARM_START=0
CLEAN_OLD_MODELS=1
TRAINING_SPLIT=0.85
EPOCHS=200
BATCH_SIZE=16
WINDOW_SIZE=64
LEARNING_RATE=0.0002
WEIGHT_DECAY=0.00001

# --- Data Options ---
RANDOM_SEED=1
# The model pulls its parameters from here and adjusts to the input data
EXPORT_DVS=1
EXPORT_APS=1
BINSIZE_MS=50
HEIGHT=224
WIDTH=224
# 16 for np.float16 or 32 for np.float32 respectively
PRECISION=32
AUGMENT_DATA=1

# --- Preprocessing Options ---
# if true, the pruned data will be in Training/Testing in PROCESSED_DIR
PERFORM_PRUNING=1
WINDOWED_PRUNING=1
# the below don't matter if PERFORM_PRUNING is 0
SPEED_PRUNING=1
STEERING_PRUNING=1
# km/h for speed to be considered high enough
SPEED_THRESHOLD=15
# absolute value for degree of steering to be considered high enough
STEERING_THRESHOLD=5
STEERING_DISCARD_CHANCE=0.7
# Angles not between these values are pruned
MIN_STEERING=-180
MAX_STEERING=180

# --- Location Options ---
# Local to the repository
DDD20_UTILS_DIR=ddd20-utils
VENV_DIR=.dddutils
CSV_FILE=my_utils/csv_files/recording-start-stop.csv

# External to the repository
# For binning with prepare-data.sh
IN_DIR=/srv/scratch/A2RoboRes/OltansDatasets/DDD-All
OUT_DIR=/srv/scratch/A2RoboRes/OltansDatasets/Binned-Recordings/bin${BINSIZE_MS}ms

# Where preprocessing should output/Where symlinks should be created from (if already preprocessed)
PROCESSED_DIR=/srv/scratch/A2RoboRes/OltansDatasets/Preprocessed-Recordings

MODEL_SAVE_DIR=/srv/scratch/A2RoboRes/OltansDatasets/models/${MODEL_TYPE}
IMAGES_DIR=/srv/scratch/A2RoboRes/OltansDatasets/img/${MODEL_TYPE}
