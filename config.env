PACKAGE_NAME=ddd-rnn
# --- Data Options ---
# The model pulls its parameters from here and adjusts to the input data
EXPORT_DVS=1
EXPORT_APS=1
BINSIZE_MS=50
HEIGHT=224
WIDTH=224
# 16 for np.float16 or 32 for np.float32 respectively
PRECISION=16

# --- Location Options ---
DDD20_UTILS_DIR=ddd20-utils
VENV_DIR=.dddutils
IN_DIR=datasets/Raw-Recordings
OUT_DIR=datasets/Processed-Recordings
CSV_FILE=recording-start-stop.csv
MODEL_SAVE_DIR=/srv/scratch/A2RoboRes/OltansDatasets/models
DATA_ORIGIN_DIR=/srv/scratch/A2RoboRes/OltansDatasets/DDD17
PROCESSED_DIR=/srv/scratch/A2RoboRes/OltansDatasets/Processed-Recordings
# --- Preprocessing Options ---
# if true, the pruned data will be saved in OUT_DIR/Training/Pruned-Recordings
PERFORM_PRUNING=1
# the below don't matter if PERFORM_PRUNING is 0
SPEED_PRUNING=1
STEERING_PRUNING=1
# km/h for speed to be considered high enough
SPEED_THRESHOLD=15
# absolute value for degree of steering to be considered high enough
STEERING_THRESHOLD=5
STEERING_DISCARD_CHANCE=0.7

# --- Training Options ---
USE_DVS=1
USE_APS=1
WARM_START=1
USE_STATED=0
CLEAN_OLD_MODELS=0
TRAINING_SPLIT=0.8
EPOCHS=100
BATCH_SIZE=512
LEARNING_RATE=0.001
WEIGHT_DECAY=0.0001