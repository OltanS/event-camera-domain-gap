PACKAGE_NAME=ddd-rnn

# --- Data Visualisation Options ---
ANIMATE_LOADER=0

# --- Training Options ---
# See options in src/model_utils.py
MODEL_TYPE="R2Plus1dtanh"
USE_DVS=1
USE_APS=1
WARM_START=1
BATCH_SIZE=16
EPOCHS=100
LEARNING_RATE=1e-4
WEIGHT_DECAY=1e-5
# 16 for np.float16 or 32 for np.float32 respectively
PRECISION=32
AUGMENT_DATA=10

# --- Preprocessing Options ---
TRAINING_SPLIT=0.85
# set back to 1 for final training, this is for testing.
PORTION_OF_DATASET=1
WINDOW_SIZE=8
RANDOM_SEED=1
PERFORM_PRUNING=1
# the below don't matter if PERFORM_PRUNING is 0
PRUNE_SPEED=1
PRUNE_STEERING=1
# km/h for speed to be considered high enough
SPEED_THRESHOLD=15
# absolute value for degree of steering to be considered high enough
STEERING_THRESHOLD=5
STEERING_DISCARD_CHANCE=0.7
# Angles not between these values are pruned
MIN_STEERING=-180
MAX_STEERING=180

# --- Data Options ---
# The model pulls its parameters from here and adjusts to the input data in my_utils/prepare-dataset.sh
EXPORT_DVS=1
EXPORT_APS=1
BINSIZE_MS=50
HEIGHT=224
WIDTH=224
APS_FRAME_NAME=aps_frame_${HEIGHT}x${WIDTH}
DVS_FRAME_NAME=dvs_frame_${HEIGHT}x${WIDTH}

# --- Location Options ---
# Local to the repository
DDD20_UTILS_DIR=ddd20-utils
VENV_DIR=.dddutils
CSV_FILE=my_utils/csv_files/recording-start-stop.csv
CSV_FILE_MANUAL=my_utils/csv_files/real-start-stop.csv

# External to the repository
# For binning with prepare-data.sh
IN_DIR=/srv/scratch/A2RoboRes/OltansDatasets/DDD-All
OUT_DIR=/srv/scratch/A2RoboRes/OltansDatasets/Binned-Recordings/bin${BINSIZE_MS}ms

# Where preprocessing should output
PROCESSED_DIR=/srv/scratch/A2RoboRes/OltansDatasets/Preprocessed-Recordings
DATA_DIR=${PROCESSED_DIR}
TRAINING_DIR=${DATA_DIR}/Training
TEST_DIR=${DATA_DIR}/Test

MODEL_SAVE_DIR=/srv/scratch/A2RoboRes/OltansDatasets/models/${MODEL_TYPE}
IMAGES_DIR=/srv/scratch/A2RoboRes/OltansDatasets/img/${MODEL_TYPE}
